# Blockchain & Wallet
POLYGON_WALLET_PRIVATE_KEY=""
WALLET_ADDRESS=""  # Your wallet address for display

# Chainstack Configuration (Primary Node)
CHAINSTACK_RPC_URL=""  # e.g., https://polygon-mainnet.core.chainstack.com/YOUR_KEY
CHAINSTACK_WS_URL=""   # e.g., wss://polygon-mainnet.core.chainstack.com/ws/YOUR_KEY

# Polymarket API (Optional: Pre-derived CLOB credentials)
CLOB_API_KEY=""
CLOB_SECRET=""
CLOB_PASS_PHRASE=""

# Weather APIs
OPENWEATHER_API_KEY=""  # https://openweathermap.org/api
WEATHERAPI_KEY=""       # https://www.weatherapi.com/
NOAA_API_KEY=""         # Optional: https://www.ncdc.noaa.gov/cdo-web/token

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Kalshi API (US-legal prediction market)
# Option 1: API Key Authentication (recommended, more secure)
KALSHI_API_KEY_ID=""         # Your Kalshi API key ID
KALSHI_API_PRIVATE_KEY=""    # Your Kalshi API private key

# Option 2: Email/Password Authentication (alternative)
KALSHI_EMAIL=""              # Your Kalshi account email
KALSHI_PASSWORD=""           # Your Kalshi account password

KALSHI_USE_DEMO=false        # Set to true for demo environment

# Trading Parameters
MAX_POSITION_SIZE_USDC=5.0       # Max bet size per trade
MIN_EDGE_THRESHOLD=0.05          # Min edge (5%) to enter trade
MIN_CONFIDENCE=0.70              # Min confidence to trade
MAX_DAILY_TRADES=50              # Max trades per day
MAX_OPEN_POSITIONS=20            # Max concurrent positions

# Extreme Value Strategy (RECOMMENDED - High ROI)
EXTREME_YES_MAX_PRICE=0.15       # Max price to buy YES (15¢)
EXTREME_YES_IDEAL_PRICE=0.10     # Ideal YES price (10¢)
EXTREME_NO_MIN_YES_PRICE=0.40    # Min YES price to buy NO (40¢)
EXTREME_NO_IDEAL_YES_PRICE=0.50  # Ideal YES price for NO (50¢)
EXTREME_MIN_POSITION=0.50        # Min position size ($0.50)
EXTREME_MAX_POSITION=1.00        # Standard max position ($1.00)
EXTREME_AGGRESSIVE_MAX=5.00      # Max for great opportunities ($5.00)

# Risk Management
BANKROLL_USDC=1000.0             # Total bankroll
POSITION_SIZE_PCT=0.01           # 1% of bankroll per trade
STOP_LOSS_PCT=0.50               # Stop trading if down 50%

# Bot Behavior
POLL_INTERVAL_MINUTES=15         # How often to scan markets
SIMULATION_MODE=true             # Set to false for live trading
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR

# Data Storage
CACHE_DIR=./data/cache
WEATHER_DB_DIR=./data/weather_db
LOG_DIR=./logs

# Optional: Advanced Features
# ENABLE_ML_FORECASTS=false
# ENABLE_ENSEMBLE_MODELS=true
